<?xml version="1.0" encoding="utf-8"?>
<!--
  TapRhythm launcher mark.

  Three lanes, one falling note each, converging on a glowing hit-line —
  the game's own three-gesture-lane mechanic, not a borrowed shooting-gallery
  icon. 108dp viewport; safe zone is the middle 66dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Three lane guides -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3300F5FF"
        android:strokeWidth="2.5"
        android:pathData="M32,16 L32,86" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33FF2DD6"
        android:strokeWidth="2.5"
        android:pathData="M54,16 L54,86" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33FFE84A"
        android:strokeWidth="2.5"
        android:pathData="M76,16 L76,86" />

    <!-- Falling notes, staggered heights, each a diamond -->
    <path
        android:strokeColor="#00F5FF"
        android:strokeWidth="3"
        android:fillColor="#8000F5FF"
        android:strokeLineJoin="round"
        android:pathData="M32,26 L40,34 L32,42 L24,34 Z" />
    <path
        android:strokeColor="#FF2DD6"
        android:strokeWidth="3"
        android:fillColor="#80FF2DD6"
        android:strokeLineJoin="round"
        android:pathData="M54,42 L62,50 L54,58 L46,50 Z" />
    <path
        android:strokeColor="#FFE84A"
        android:strokeWidth="3"
        android:fillColor="#80FFE84A"
        android:strokeLineJoin="round"
        android:pathData="M76,34 L84,42 L76,50 L68,42 Z" />

    <!-- Hit-line -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M22,78 L86,78" />
    <path
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="1.6"
        android:pathData="M22,84 L86,84" />
</vector>
